{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "PermissionOperation": {
      "enum": [
        "read",
        "write",
        "execute",
        "delete",
        "spawn",
        "send",
        "approve",
        "seal"
      ],
      "title": "PermissionOperation",
      "type": "string"
    },
    "PermissionResource": {
      "enum": [
        "project_path",
        "project_state",
        "mailbox",
        "evidence",
        "process",
        "network",
        "git_repository"
      ],
      "title": "PermissionResource",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Backend Id",
      "type": "string"
    },
    "command": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "definition_version": {
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "kind": {
      "const": "backend_definition",
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "enum": [
          "no_os_sandbox",
          "no_mcp"
        ],
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_operations": {
      "items": {
        "$ref": "#/$defs/PermissionOperation"
      },
      "title": "Supported Operations",
      "type": "array"
    },
    "supported_resources": {
      "items": {
        "$ref": "#/$defs/PermissionResource"
      },
      "title": "Supported Resources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "definition_version",
    "kind",
    "backend_id",
    "provider",
    "command",
    "supported_operations",
    "supported_resources"
  ],
  "title": "BackendDefinition",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "BackendDefinition",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
