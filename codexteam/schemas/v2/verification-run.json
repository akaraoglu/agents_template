{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/RecordRef"
    },
    "change_set": {
      "$ref": "#/$defs/RecordRef"
    },
    "command": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "kind": {
      "const": "verification_run",
      "title": "Kind",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/RecordRef"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "verification_run_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Verification Run Id",
      "type": "string"
    },
    "workspace_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workspace Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "verification_run_id",
    "plan",
    "candidate",
    "change_set",
    "workspace_digest",
    "command",
    "exit_code",
    "duration_seconds",
    "evidence",
    "started_at",
    "finished_at"
  ],
  "title": "VerificationRun",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "VerificationRun",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
