{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "operator",
            "project_lead",
            "agent",
            "orchestrator",
            "launcher"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role_instance_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Instance Id"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "return",
        "escalate",
        "cancel"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "kind": {
      "const": "lead_decision",
      "title": "Kind",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/RecordRef"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "decision_id",
    "decision",
    "subject",
    "rationale",
    "decided_by",
    "decided_at"
  ],
  "title": "LeadDecision",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "LeadDecision",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
