{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "PermissionOperation": {
      "enum": [
        "read",
        "write",
        "execute",
        "delete",
        "spawn",
        "send",
        "approve",
        "seal"
      ],
      "title": "PermissionOperation",
      "type": "string"
    },
    "PermissionResource": {
      "enum": [
        "project_path",
        "project_state",
        "mailbox",
        "evidence",
        "process",
        "network",
        "git_repository"
      ],
      "title": "PermissionResource",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Capability Id",
      "type": "string"
    },
    "definition_version": {
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "const": "capability",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "required_operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PermissionOperation"
      },
      "title": "Required Operations",
      "type": "array"
    },
    "required_resources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PermissionResource"
      },
      "title": "Required Resources",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "definition_version",
    "kind",
    "capability_id",
    "name",
    "description"
  ],
  "title": "Capability",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "Capability",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
