{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "CriterionDisposition": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "claimed_satisfied",
            "verified",
            "unsatisfied",
            "not_evaluated"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_types": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceType"
          },
          "title": "Evidence Types",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "criterion_id",
        "disposition"
      ],
      "title": "CriterionDisposition",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "test_output",
        "manifest",
        "review",
        "analysis",
        "artifact"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment": {
      "$ref": "#/$defs/RecordRef"
    },
    "attempt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "candidate_report_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Candidate Report Id",
      "type": "string"
    },
    "change_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_pack": {
      "$ref": "#/$defs/RecordRef"
    },
    "criterion_dispositions": {
      "items": {
        "$ref": "#/$defs/CriterionDisposition"
      },
      "title": "Criterion Dispositions",
      "type": "array"
    },
    "criterion_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Criterion Ids",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "kind": {
      "const": "candidate_report",
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "correction_needed",
        "blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "pipeline_revision": {
      "$ref": "#/$defs/RecordRef"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "role_instance": {
      "$ref": "#/$defs/RecordRef"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "enum": [
        "discovery",
        "architecture",
        "ux",
        "implementation",
        "verification",
        "assurance",
        "review"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stage_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Stage Id",
      "type": "string"
    },
    "stage_spec_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Stage Spec Digest",
      "type": "string"
    },
    "work_item": {
      "$ref": "#/$defs/RecordRef"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "candidate_report_id",
    "work_item",
    "pipeline_revision",
    "assignment",
    "role_instance",
    "stage",
    "stage_id",
    "stage_spec_digest",
    "attempt_id",
    "context_pack",
    "outcome",
    "criterion_ids",
    "criterion_dispositions",
    "produced_at"
  ],
  "title": "CandidateReport",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "CandidateReport",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
