{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "AssuranceDomain": {
      "enum": [
        "security_privacy",
        "data_database",
        "accessibility",
        "performance_reliability"
      ],
      "title": "AssuranceDomain",
      "type": "string"
    },
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "kind",
        "definition_version",
        "digest"
      ],
      "title": "DefinitionRef",
      "type": "object"
    },
    "PipelineStageSpec": {
      "additionalProperties": false,
      "properties": {
        "agent_spec": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "assurance_domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssuranceDomain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "optional": {
          "title": "Optional",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "discovery",
            "architecture",
            "ux",
            "implementation",
            "verification",
            "assurance",
            "review"
          ],
          "title": "Stage",
          "type": "string"
        },
        "stage_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stage Id",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "stage",
        "agent_spec",
        "dependencies",
        "optional"
      ],
      "title": "PipelineStageSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "definition_version": {
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "kind": {
      "const": "pipeline_definition",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "pipeline_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Pipeline Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/PipelineStageSpec"
      },
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "definition_version",
    "kind",
    "pipeline_id",
    "name",
    "stages"
  ],
  "title": "PipelineDefinition",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "PipelineDefinition",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
