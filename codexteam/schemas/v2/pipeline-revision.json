{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "AssuranceDomain": {
      "enum": [
        "security_privacy",
        "data_database",
        "accessibility",
        "performance_reliability"
      ],
      "title": "AssuranceDomain",
      "type": "string"
    },
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "kind",
        "definition_version",
        "digest"
      ],
      "title": "DefinitionRef",
      "type": "object"
    },
    "FrozenStageDigest": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stage Id",
          "type": "string"
        },
        "stage_spec_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stage Spec Digest",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "stage_spec_digest"
      ],
      "title": "FrozenStageDigest",
      "type": "object"
    },
    "ParentStageDigest": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "description": "Digest pinned from the same stage in the resolved parent revision; the compiler MUST verify it against that external parent revision.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "stage_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stage Id",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "digest"
      ],
      "title": "ParentStageDigest",
      "type": "object"
    },
    "PipelineStageSpec": {
      "additionalProperties": false,
      "properties": {
        "agent_spec": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "assurance_domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssuranceDomain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "optional": {
          "title": "Optional",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "discovery",
            "architecture",
            "ux",
            "implementation",
            "verification",
            "assurance",
            "review"
          ],
          "title": "Stage",
          "type": "string"
        },
        "stage_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Stage Id",
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "stage",
        "agent_spec",
        "dependencies",
        "optional"
      ],
      "title": "PipelineStageSpec",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applies_from_stage": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Applies From Stage",
      "type": "string"
    },
    "approving_decision": {
      "$ref": "#/$defs/RecordRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "frozen_stage_digests": {
      "items": {
        "$ref": "#/$defs/FrozenStageDigest"
      },
      "title": "Frozen Stage Digests",
      "type": "array"
    },
    "frozen_stage_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Frozen Stage Ids",
      "type": "array"
    },
    "kind": {
      "const": "pipeline_revision",
      "title": "Kind",
      "type": "string"
    },
    "parent_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_stage_digests": {
      "description": "Parent revision stage digests supplied after resolution; the compiler MUST verify these values against the resolved parent_revision record.",
      "items": {
        "$ref": "#/$defs/ParentStageDigest"
      },
      "title": "Parent Stage Digests",
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/RecordRef"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Revision Id",
      "type": "string"
    },
    "revision_number": {
      "minimum": 1,
      "title": "Revision Number",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/PipelineStageSpec"
      },
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "revision_id",
    "plan",
    "revision_number",
    "stages",
    "frozen_stage_ids",
    "frozen_stage_digests",
    "parent_stage_digests",
    "applies_from_stage",
    "reason",
    "approving_decision",
    "created_at"
  ],
  "title": "PipelineRevision",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "PipelineRevision",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
