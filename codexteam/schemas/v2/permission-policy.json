{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "PermissionOperation": {
      "enum": [
        "read",
        "write",
        "execute",
        "delete",
        "spawn",
        "send",
        "approve",
        "seal"
      ],
      "title": "PermissionOperation",
      "type": "string"
    },
    "PermissionResource": {
      "enum": [
        "project_path",
        "project_state",
        "mailbox",
        "evidence",
        "process",
        "network",
        "git_repository"
      ],
      "title": "PermissionResource",
      "type": "string"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        },
        "exception_class": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Exception Class",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/PermissionOperation"
        },
        "resource": {
          "$ref": "#/$defs/PermissionResource"
        },
        "resource_pattern": {
          "minLength": 1,
          "title": "Resource Pattern",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "exception_class",
        "effect",
        "operation",
        "resource",
        "resource_pattern"
      ],
      "title": "PermissionRule",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_effect": {
      "const": "deny",
      "title": "Default Effect",
      "type": "string"
    },
    "definition_version": {
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "kind": {
      "const": "permission_policy",
      "title": "Kind",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/PermissionRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "definition_version",
    "kind",
    "policy_id",
    "default_effect",
    "rules"
  ],
  "title": "PermissionPolicy",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "PermissionPolicy",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
