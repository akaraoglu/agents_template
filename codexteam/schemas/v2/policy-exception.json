{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "kind",
        "definition_version",
        "digest"
      ],
      "title": "DefinitionRef",
      "type": "object"
    },
    "PermissionOperation": {
      "enum": [
        "read",
        "write",
        "execute",
        "delete",
        "spawn",
        "send",
        "approve",
        "seal"
      ],
      "title": "PermissionOperation",
      "type": "string"
    },
    "PermissionResource": {
      "enum": [
        "project_path",
        "project_state",
        "mailbox",
        "evidence",
        "process",
        "network",
        "git_repository"
      ],
      "title": "PermissionResource",
      "type": "string"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        },
        "exception_class": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Exception Class",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/PermissionOperation"
        },
        "resource": {
          "$ref": "#/$defs/PermissionResource"
        },
        "resource_pattern": {
          "minLength": 1,
          "title": "Resource Pattern",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "exception_class",
        "effect",
        "operation",
        "resource",
        "resource_pattern"
      ],
      "title": "PermissionRule",
      "type": "object"
    },
    "PolicyRuleSnapshot": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/DefinitionRef"
        },
        "rule": {
          "$ref": "#/$defs/PermissionRule"
        },
        "rule_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rule Digest",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "rule",
        "rule_digest"
      ],
      "title": "PolicyRuleSnapshot",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approving_lead_decision": {
      "$ref": "#/$defs/RecordRef"
    },
    "compensating_verification": {
      "minLength": 1,
      "title": "Compensating Verification",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "kind": {
      "const": "policy_exception",
      "title": "Kind",
      "type": "string"
    },
    "policy_exception_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Policy Exception Id",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "rule": {
      "$ref": "#/$defs/PolicyRuleSnapshot"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "policy_exception_id",
    "rule",
    "scope",
    "reason",
    "evidence",
    "compensating_verification",
    "expires_at",
    "approving_lead_decision"
  ],
  "title": "PolicyException",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "PolicyException",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
