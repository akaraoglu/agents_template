{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "kind",
        "definition_version",
        "digest"
      ],
      "title": "DefinitionRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_spec_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Agent Spec Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/DefinitionRef"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "definition_version": {
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "guidance_bundle": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "kind": {
      "const": "agent_spec",
      "title": "Kind",
      "type": "string"
    },
    "model_profile": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "permission_policy": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "responsibility": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "definition_version",
    "kind",
    "agent_spec_id",
    "responsibility",
    "capabilities",
    "permission_policy",
    "guidance_bundle",
    "model_profile"
  ],
  "title": "AgentSpec",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "AgentSpec",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
