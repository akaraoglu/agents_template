{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "EvidenceType": {
      "enum": [
        "test_output",
        "manifest",
        "review",
        "analysis",
        "artifact"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "MachineVerificationSpec": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "expected_stdout": {
          "title": "Expected Stdout",
          "type": "string"
        },
        "verifier_argv": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Verifier Argv",
          "type": "array"
        }
      },
      "required": [
        "verifier_argv",
        "argv",
        "expected_stdout"
      ],
      "title": "MachineVerificationSpec",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "VerificationCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "required_evidence_types": {
          "items": {
            "$ref": "#/$defs/EvidenceType"
          },
          "title": "Required Evidence Types",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/MachineVerificationSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "criterion_id",
        "statement",
        "required_evidence_types"
      ],
      "title": "VerificationCriterion",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "items": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "title": "Commands",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/VerificationCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "kind": {
      "const": "verification_plan",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_plan_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Verification Plan Id",
      "type": "string"
    },
    "work_item": {
      "$ref": "#/$defs/RecordRef"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "verification_plan_id",
    "work_item",
    "criteria",
    "commands",
    "created_at"
  ],
  "title": "VerificationPlan",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "VerificationPlan",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
