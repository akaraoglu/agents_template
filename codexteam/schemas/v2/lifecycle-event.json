{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "operator",
            "project_lead",
            "agent",
            "orchestrator",
            "launcher"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role_instance_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Instance Id"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "LifecycleEventType": {
      "enum": [
        "status_changed",
        "assignment_started",
        "assignment_completed",
        "candidate_reported",
        "verification_completed",
        "decision_recorded",
        "candidate_sealed",
        "project_closed",
        "cancelled"
      ],
      "title": "LifecycleEventType",
      "type": "string"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "aggregate_version": {
      "minimum": 1,
      "title": "Aggregate Version",
      "type": "integer"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/LifecycleEventType"
    },
    "from_status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "review",
        "sealed",
        "closed",
        "cancelled"
      ],
      "title": "From Status",
      "type": "string"
    },
    "kind": {
      "const": "lifecycle_event",
      "title": "Kind",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_event_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Digest"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/RecordRef"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "to_status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "review",
        "sealed",
        "closed",
        "cancelled"
      ],
      "title": "To Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "event_id",
    "aggregate_version",
    "event_type",
    "from_status",
    "to_status",
    "actor",
    "subject",
    "summary",
    "occurred_at"
  ],
  "title": "LifecycleEvent",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "LifecycleEvent",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
