{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "AssuranceDomain": {
      "enum": [
        "security_privacy",
        "data_database",
        "accessibility",
        "performance_reliability"
      ],
      "title": "AssuranceDomain",
      "type": "string"
    },
    "DefinitionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "kind",
        "definition_version",
        "digest"
      ],
      "title": "DefinitionRef",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "digest"
      ],
      "title": "RecordRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_spec": {
      "$ref": "#/$defs/DefinitionRef"
    },
    "assignment_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Assignment Id",
      "type": "string"
    },
    "assurance_domain": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssuranceDomain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "const": "assignment",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "stage": {
      "enum": [
        "discovery",
        "architecture",
        "ux",
        "implementation",
        "verification",
        "assurance",
        "review"
      ],
      "title": "Stage",
      "type": "string"
    },
    "work_item": {
      "$ref": "#/$defs/RecordRef"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "assignment_id",
    "work_item",
    "stage",
    "agent_spec",
    "scope"
  ],
  "title": "Assignment",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "Assignment",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
