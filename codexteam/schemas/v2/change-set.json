{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "ChangeEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "after_digest": {
                "type": "string"
              },
              "before_digest": {
                "type": "null"
              }
            },
            "required": [
              "after_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "modify"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "before_digest",
              "after_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "after_digest": {
                "type": "null"
              },
              "before_digest": {
                "type": "string"
              }
            },
            "required": [
              "before_digest"
            ]
          }
        }
      ],
      "properties": {
        "action": {
          "enum": [
            "create",
            "modify",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "after_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Digest"
        },
        "before_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Digest"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "action"
      ],
      "title": "ChangeEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Manifest Digest",
      "type": "string"
    },
    "change_set_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Change Set Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ChangeEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "final_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Manifest Digest",
      "type": "string"
    },
    "kind": {
      "const": "change_set",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "change_set_id",
    "base_manifest_digest",
    "final_manifest_digest",
    "entries",
    "created_at"
  ],
  "title": "ChangeSet",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "ChangeSet",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
