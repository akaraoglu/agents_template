{
  "$comment": "Structural validation is necessary but semantic and cross-record validation MUST use codexteam_tools.v2.models.validate_wire plus the model named in x-codexteam-semantic-model.",
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "operator",
            "project_lead",
            "agent",
            "orchestrator",
            "launcher"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role_instance_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Instance Id"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "test_output",
        "manifest",
        "review",
        "analysis",
        "artifact"
      ],
      "title": "EvidenceType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "kind": {
      "const": "evidence_artifact",
      "title": "Kind",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$",
      "title": "Path",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ActorRef"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "evidence_id",
    "evidence_type",
    "path",
    "digest",
    "size_bytes",
    "producer",
    "created_at"
  ],
  "title": "EvidenceArtifact",
  "type": "object",
  "x-codexteam-contract-version": "2.0",
  "x-codexteam-semantic-model": "EvidenceArtifact",
  "x-codexteam-semantic-module": "codexteam_tools.v2.models"
}
