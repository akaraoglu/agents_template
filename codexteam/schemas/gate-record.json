{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.gate-record",
  "title": "CodexTeam Gate Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate", "status", "project_root", "started_at", "completed_at", "duration_seconds", "verification_paths", "configuration_digest", "workspace_digest", "commands"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"enum": ["development", "integration"]},
    "status": {"enum": ["passed", "failed"]},
    "project_root": {"type": "string", "pattern": "^/"},
    "execution_surface": {"type": "string", "enum": ["worker", "lead_host"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "verification_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "configuration_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "argv", "exit_code", "duration_seconds", "stdout_tail", "stderr_tail"],
        "properties": {
          "gate": {"enum": ["development", "integration"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "stdout_tail": {"type": "string"},
          "stderr_tail": {"type": "string"}
        }
      }
    }
  }
}
