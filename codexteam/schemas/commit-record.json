{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.commit-record",
  "title": "CodexTeam Commit Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary_id", "status", "project_root", "branch", "head_before", "head_after", "tree", "committed_paths", "verification", "commit_subject", "committed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "boundary_id": {"type": "string"},
    "status": {"const": "committed"},
    "project_root": {"type": "string", "pattern": "^/"},
    "branch": {"type": "string"},
    "head_before": {"type": ["string", "null"]},
    "head_after": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "committed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "verification": {"type": "object"},
    "commit_subject": {"type": "string"},
    "committed_at": {"type": "string", "format": "date-time"}
  }
}
