{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.draft",
  "title": "CodexTeam Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "evidence",
    "findings",
    "limitations",
    "proposed_disposition"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "outcome": {"type": "string", "minLength": 1, "maxLength": 1200, "pattern": ".*\\S.*"},
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "summary"],
        "properties": {
          "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*"}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": ".*\\S.*"}
    },
    "proposed_disposition": {
      "type": "string",
      "enum": ["ready_for_review", "correction_needed", "blocked"]
    }
  }
}
