{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.commit-plan",
  "title": "CodexTeam Commit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary_id", "project_root", "branch", "expected_head", "task_ids", "paths", "excluded_paths", "verification", "commit_subject", "commit_body", "pr_title", "pr_summary", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "boundary_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "project_root": {"type": "string", "pattern": "^/"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 255},
    "expected_head": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"},
    "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^T[0-9]{3,6}$"}, "uniqueItems": true},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "excluded_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_ref", "workspace_digest"],
      "properties": {
        "kind": {"enum": ["integration", "architecture"]},
        "artifact_ref": {"type": "string", "minLength": 1},
        "workspace_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "commit_subject": {"type": "string", "minLength": 1, "maxLength": 72},
    "commit_body": {"type": "string", "maxLength": 4000},
    "pr_title": {"type": "string", "minLength": 1, "maxLength": 200},
    "pr_summary": {"type": "string", "minLength": 1, "maxLength": 10000},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
