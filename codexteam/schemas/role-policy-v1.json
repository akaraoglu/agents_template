{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.role-policy.v1",
  "title": "CodexTeam Role Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "name",
    "description",
    "developer_instructions",
    "default_profile",
    "default_reasoning_effort",
    "sandbox_mode",
    "skill_files",
    "allowed_change_patterns",
    "denied_change_patterns",
    "allowed_evidence_types"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "role": {"enum": ["architect", "developer", "tester", "reviewer", "documenter", "feature_planner", "git_steward", "leader", "ux_designer"]},
    "name": {"type": "string", "pattern": "^codexteam_[a-z][a-z0-9_]{1,63}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "developer_instructions": {"type": "string", "minLength": 1, "maxLength": 8000},
    "default_profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "default_reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
    "sandbox_mode": {"enum": ["read-only", "workspace-write"]},
    "skill_files": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "mcp_servers": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
      "uniqueItems": true
    },
    "allowed_change_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "denied_change_patterns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_evidence_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["test_output", "artifact", "file_manifest", "cli_invocation", "spec_compliance", "code_review"]
      },
      "uniqueItems": true
    }
  }
}
