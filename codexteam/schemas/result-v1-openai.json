{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.result.v1.openai",
  "title": "CodexTeam Result v1 OpenAI Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "team_id",
    "task_id",
    "agent_role",
    "attempt_id",
    "status",
    "summary",
    "output",
    "file_changes",
    "evidence",
    "requested_followups",
    "errors",
    "warnings",
    "limitations",
    "produced_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "result_id": {"type": "string"},
    "team_id": {"type": "string"},
    "task_id": {"type": "string"},
    "agent_role": {
      "type": "string",
      "enum": [
        "architect",
        "developer",
        "tester",
        "reviewer",
        "documenter",
        "feature_planner",
        "git_steward",
        "leader",
        "ux_designer"
      ]
    },
    "attempt_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "partial", "blocked", "needs_review"]
    },
    "summary": {"type": "string"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "stdout_tail",
        "stderr_tail",
        "duration_seconds"
      ],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"},
        "duration_seconds": {"type": "number"}
      }
    },
    "file_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action"],
        "properties": {
          "path": {"type": "string"},
          "action": {
            "type": "string",
            "enum": ["created", "modified", "deleted"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "artifact_ref", "summary"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "test_output",
              "artifact",
              "file_manifest",
              "cli_invocation",
              "spec_compliance",
              "code_review"
            ]
          },
          "artifact_ref": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    },
    "requested_followups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_type", "target_role", "reason"],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": ["request_review", "delegate_task", "request_approval"]
          },
          "target_role": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "produced_at": {"type": "string", "pattern": "Z$"}
  }
}
