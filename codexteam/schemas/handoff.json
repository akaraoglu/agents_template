{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.handoff",
  "title": "CodexTeam Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "team_id", "task_id", "attempt_id", "agent_role", "execution_spec", "workspace_root", "task_context", "constraints", "completion_criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "team_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "agent_role": {"enum": ["architect", "developer", "tester", "reviewer", "documenter", "feature_planner", "git_steward", "leader", "ux_designer"]},
    "execution_spec": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "path", "digest"],
      "properties": {
        "contract": {"const": "execution-spec"},
        "path": {"const": "execution-spec.json"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "role_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_version", "digest"],
      "properties": {
        "name": {"type": "string", "pattern": "^codexteam_[a-z][a-z0-9_]{1,63}$"},
        "schema_version": {"const": "1.0"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "workspace_root": {"type": "string", "pattern": "^/"},
    "task_context": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "guidance_files": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}}
      }
    },
    "instruction_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "files"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}}
      }
    },
    "constraints": {"type": "object"},
    "completion_criteria": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}, "minItems": 1}
  }
}
