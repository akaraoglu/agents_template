{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codexteam.result.v1",
  "title": "CodexTeam Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "result_id",
    "team_id",
    "task_id",
    "agent_role",
    "attempt_id",
    "status",
    "summary",
    "output",
    "file_changes",
    "evidence",
    "requested_followups",
    "errors",
    "warnings",
    "limitations",
    "produced_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "team_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"},
    "agent_role": {"enum": ["architect", "developer", "tester", "reviewer", "documenter", "git_steward", "leader"]},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "status": {"enum": ["completed", "failed", "partial", "blocked", "needs_review"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": ["exit_code", "stdout_tail", "stderr_tail", "duration_seconds"],
      "properties": {
        "exit_code": {"type": "integer"},
        "stdout_tail": {"type": "string"},
        "stderr_tail": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "file_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "action"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "action": {"enum": ["created", "modified", "deleted"]},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "artifact_ref", "summary"],
        "properties": {
          "type": {"enum": ["test_output", "artifact", "file_manifest", "cli_invocation", "spec_compliance", "code_review"]},
          "artifact_ref": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    },
    "requested_followups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["action_type", "target_role", "reason"],
        "properties": {
          "action_type": {"enum": ["request_review", "delegate_task", "request_approval"]},
          "target_role": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "pattern": "^T[0-9]{3,6}$"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "produced_at": {"type": "string", "format": "date-time"}
  }
}
